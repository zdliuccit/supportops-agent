# 单独复制到仓库外；仅Compose非秘密配置，不得复用server.env。
# 本地数据库当前为PG17，远程须按实际主版本选择已批准的Debian镜像digest。
SUPPORTOPS_BACKUP_CLIENT_IMAGE=postgres:17-bookworm@sha256:<approved-digest>
# 离线核验只用现有Python标准库；独立只读容器禁网络，不挂载连接/秘密文件。
SUPPORTOPS_BACKUP_INSPECTOR_IMAGE=python:3.12-slim-bookworm@sha256:<approved-digest>
SUPPORTOPS_BACKUP_ARCHIVE_DIR=/absolute/controlled/encrypted/backup-directory/<backup-id>
SUPPORTOPS_BACKUP_UID=<approved-backup-uid>
SUPPORTOPS_BACKUP_GID=<approved-backup-gid>
SUPPORTOPS_BACKUP_SERVICE_FILE=/absolute/controlled/path/pg_service.conf
SUPPORTOPS_BACKUP_PASS_FILE=/absolute/controlled/path/pgpass
SUPPORTOPS_BACKUP_CA_FILE=/absolute/controlled/path/database-ca.crt
SUPPORTOPS_BACKUP_OUTPUT_DIR=/absolute/controlled/encrypted/backup-directory
SUPPORTOPS_BACKUP_RECOVERY_REFERENCES_FILE=/absolute/controlled/recovery-references/recovery-references.json
# 引用配置核对仅挂载这个私有目录，目录内须只有上面同一份recovery-references.json。
SUPPORTOPS_BACKUP_RECOVERY_REFERENCES_DIR=/absolute/controlled/recovery-references
SUPPORTOPS_BACKUP_TARGET_ALIAS=<approved-dedicated-database-alias>
SUPPORTOPS_BACKUP_CHECKPOINT_SCHEMA=supportops_checkpoints
# 引用清单须独立受控保留：应用版本/digest、角色与扩展基线、密封密钥revision/
# provider引用及外部来源文件的独立备份关联；这里只记录摘要，不注入秘密值。
SUPPORTOPS_BACKUP_RECOVERY_REFERENCES_SHA256=<approved-reference-manifest-sha256>
SUPPORTOPS_BACKUP_STORAGE_APPROVED=false
SUPPORTOPS_BACKUP_DATABASE_SCOPE=unapproved
SUPPORTOPS_BACKUP_TIMEOUT_SECONDS=900
SUPPORTOPS_BACKUP_MAX_BYTES=1073741824

# 复制到仓库外并限制为本人可读；smoke.sh 会核对该文件的属主和 0400/0600 权限。
# 基础镜像必须填已批准、已验证的不可变 digest，不使用 latest 或占位值。
SUPPORTOPS_PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:<approved-digest>
SUPPORTOPS_UV_IMAGE=ghcr.io/astral-sh/uv@sha256:<approved-digest>
SUPPORTOPS_NODE_IMAGE=node:22-bookworm-slim@sha256:<approved-digest>
SUPPORTOPS_NGINX_IMAGE=nginx:alpine@sha256:<approved-digest>
# smoke.sh 为每次运行生成唯一临时 tag，不需要固定 backend tag。
SUPPORTOPS_WEB_IMAGE=supportops-web:smoke
SUPPORTOPS_RUNTIME_ENV_FILE=/absolute/private/path/smoke-server.env
SUPPORTOPS_EXPECTED_ENVIRONMENT=staging

SUPPORTOPS_SMOKE_POSTGRES_IMAGE=pgvector/pgvector:pg17@sha256:<approved-digest>
SUPPORTOPS_SMOKE_REDIS_IMAGE=redis:8-alpine@sha256:<approved-digest>
SUPPORTOPS_SMOKE_BASELINE_DUMP=/absolute/private/path/sanitized-0017.dump
SUPPORTOPS_SMOKE_BASELINE_SHA256=<independently-verified-64-character-lowercase-sha256>
# 仅供本次临时 Postgres/Redis，使用 URL-safe 的十六进制随机值。
SUPPORTOPS_SMOKE_SECRET=<ephemeral-hex-secret>

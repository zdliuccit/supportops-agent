# 仅为 Compose 非秘密输入；复制到仓库外并填写已批准的具体镜像，不直接部署此示例。
# 基础镜像必须使用实际验证的 @sha256:<digest>，不得保留占位符或选择 latest。
SUPPORTOPS_PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:<approved-digest>
SUPPORTOPS_UV_IMAGE=ghcr.io/astral-sh/uv@sha256:<approved-digest>
SUPPORTOPS_NODE_IMAGE=node:22-bookworm-slim@sha256:<approved-digest>
SUPPORTOPS_NGINX_IMAGE=nginx:alpine@sha256:<approved-digest>
# 构建时使用唯一发布 tag；构建完成记录实际 digest，运行时可改成不可变镜像引用。
SUPPORTOPS_BACKEND_IMAGE=supportops-backend:<release-id>
SUPPORTOPS_WEB_IMAGE=supportops-web:<release-id>
SUPPORTOPS_RUNTIME_ENV_FILE=/absolute/controlled/path/server.env
SUPPORTOPS_EXPECTED_ENVIRONMENT=staging
SUPPORTOPS_HTTP_PORT=8080

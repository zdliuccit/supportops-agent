# 当前运行环境；local 表示本地开发配置。
SUPPORTOPS_ENVIRONMENT=local

# 发布门禁范围。staging/production 必须有适用评测；local/dev/test 可显式开发激活并标记未验收。
SUPPORTOPS_RELEASE_STAGE=p0
SUPPORTOPS_RELEASE_EVALUATION_MAX_AGE_SECONDS=86400
SUPPORTOPS_RELEASE_SCOPE_METADATA_LIMIT=10000
# 灰度默认无批准策略；仅由受控配置注入管理台展示的规范化策略摘要，不会生成实测结果。
# SUPPORTOPS_RELEASE_ROLLOUT_POLICY_DIGEST=<approved-rollout-policy-sha256>
SUPPORTOPS_RELEASE_ROLLOUT_SCAN_INTERVAL_SECONDS=30
SUPPORTOPS_RELEASE_ROLLOUT_STALE_SECONDS=90
SUPPORTOPS_RELEASE_ROLLOUT_SCAN_BATCH_SIZE=10
# 以下批准项默认不配置；不得填写虚构摘要或用 0 冒充费用预算。缺失时正式环境拒绝激活。
# SUPPORTOPS_RELEASE_EVALUATION_DATASET_DIGEST=<approved-sha256>
# SUPPORTOPS_RELEASE_EVALUATION_LOAD_DIGEST=<approved-sha256>
# SUPPORTOPS_RELEASE_EVALUATION_RUNNER_DIGEST=<approved-sha256>
# SUPPORTOPS_RELEASE_EVALUATION_MAX_AVERAGE_COST_USD=<approved-positive-average-usd>

# PostgreSQL 数据库名称，仅用于本地开发实例。
SUPPORTOPS_POSTGRES_DB=supportops

# PostgreSQL 本地开发用户名。
SUPPORTOPS_POSTGRES_USER=agent

# PostgreSQL 本地开发密码；生产环境必须替换为独立强密码。
SUPPORTOPS_POSTGRES_PASSWORD=agent_dev

# PostgreSQL 映射到宿主机的端口。
SUPPORTOPS_POSTGRES_PORT=5432

# API 和 Worker 使用的异步 PostgreSQL 连接地址。
SUPPORTOPS_DATABASE_URL=postgresql+asyncpg://agent:agent_dev@localhost:5432/supportops

# Redis 映射到宿主机的端口。
SUPPORTOPS_REDIS_PORT=6379

# API 和 Worker 使用的 Redis 连接地址，数据库编号为 0。
SUPPORTOPS_REDIS_URL=redis://localhost:6379/0

# Redis 中用于投递 Agent 运行任务的队列名称。
SUPPORTOPS_REDIS_QUEUE_NAME=supportops:runs

# 本地 JWT 签名密钥；生产环境必须通过安全的密钥管理服务注入。
SUPPORTOPS_JWT_SECRET=replace-with-at-least-32-characters

# JWT 签发方标识。
SUPPORTOPS_JWT_ISSUER=supportops-local

# JWT 预期接收方标识。
SUPPORTOPS_JWT_AUDIENCE=supportops-api

# 是否在空数据库首次启动时创建默认公司、根组织和管理员。
SUPPORTOPS_BOOTSTRAP_ADMIN_ENABLED=true

# 首次启动创建的默认公司名称。
SUPPORTOPS_BOOTSTRAP_COMPANY_NAME=SupportOps

# 首次启动创建的默认公司唯一短名。
SUPPORTOPS_BOOTSTRAP_COMPANY_SLUG=supportops

# 首次启动创建的平台管理员登录邮箱。
SUPPORTOPS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# 首次启动平台管理员密码；生产环境必须注入独立强密码。
SUPPORTOPS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 首次启动平台管理员显示名称。
SUPPORTOPS_BOOTSTRAP_ADMIN_NAME=系统管理员

# 登录访问令牌有效时长，单位为分钟。
SUPPORTOPS_ACCESS_TOKEN_LIFETIME_MINUTES=60

# 允许访问 API 的浏览器来源列表，使用 JSON 数组格式。
SUPPORTOPS_CORS_ORIGINS=["http://localhost:5173"]

# SSE 查询数据库中新事件的时间间隔，单位为秒。
SUPPORTOPS_SSE_POLL_INTERVAL_SECONDS=0.25

# SSE 在无新事件时发送心跳的时间间隔，单位为秒。
SUPPORTOPS_SSE_HEARTBEAT_SECONDS=10

# Worker 扫描并恢复滞留队列任务的时间间隔，单位为秒。
SUPPORTOPS_WORKER_RECOVERY_INTERVAL_SECONDS=30

# 独立告警扫描，每类来源有限批次；近期终态和全时段活动来源轮转检查。
SUPPORTOPS_RUNTIME_ALERT_SCAN_INTERVAL_SECONDS=30
SUPPORTOPS_RUNTIME_ALERT_SCAN_BATCH_SIZE=50
SUPPORTOPS_RUNTIME_ALERT_SCAN_WINDOW_HOURS=24
SUPPORTOPS_RUNTIME_ALERT_OBSERVATION_GRACE_SECONDS=60
SUPPORTOPS_RUNTIME_ALERT_STALE_SECONDS=300
SUPPORTOPS_HEALTH_SNAPSHOT_STALE_SECONDS=90
# 模型 SDK 首个非空输出块阈值默认不启用；批准该指标的阈值后配置毫秒数。
# SUPPORTOPS_RUNTIME_ALERT_FIRST_OUTPUT_MS=5000

# 有界 Worker 与执行尝试；服务心跳和 Run 续租是两个独立租约。
SUPPORTOPS_WORKER_MAX_CONCURRENCY=1
SUPPORTOPS_WORKER_SCHEDULER_POLICY=tenant_round_robin
SUPPORTOPS_MODEL_PROBE_POLL_SECONDS=2
SUPPORTOPS_MODEL_PROBE_LEASE_SECONDS=60
SUPPORTOPS_MODEL_PROBE_MAX_ATTEMPTS=3
SUPPORTOPS_MODEL_PROBE_MAX_AGE_SECONDS=600
SUPPORTOPS_MODEL_PROBE_RUN_TIMEOUT_SECONDS=60
SUPPORTOPS_RUN_ATTEMPT_LEASE_SECONDS=60
SUPPORTOPS_RUN_ATTEMPT_HEARTBEAT_SECONDS=10
SUPPORTOPS_RUN_ATTEMPT_MAX_RECOVERIES=2

# 关键词索引消费；暂不配置 embedding 或向量检索。
SUPPORTOPS_KNOWLEDGE_INDEX_INTERVAL_SECONDS=5
SUPPORTOPS_KNOWLEDGE_INDEX_BATCH_SIZE=10
SUPPORTOPS_KNOWLEDGE_INDEX_MAX_ATTEMPTS=6
SUPPORTOPS_KNOWLEDGE_SEARCH_TIMEOUT_SECONDS=5
# 人工本地来源导入默认关闭；仅local/dev/test，批准文件须在仓库外受保护地维护。
# 开启还须使用PostgreSQL；创建/执行/封锁事务必须为READ COMMITTED，SQLite不支持。
SUPPORTOPS_KNOWLEDGE_INGESTION_ENABLED=false
# SUPPORTOPS_KNOWLEDGE_INGESTION_APPROVAL_FILE=<运维批准文件的绝对路径>

# 只在隔离本地/开发演示中按需启用；production 明确拒绝 true。
SUPPORTOPS_DIAGNOSTIC_MOCK_ENABLED=false
SUPPORTOPS_BUSINESS_ACTION_MOCK_ENABLED=false
SUPPORTOPS_BUSINESS_ACTION_MOCK_AUTO_CREATE_ENABLED=false
# 服务器限定审批期限；显式授予 Mock 项目人员权限后才能审批，禁止本人审批。
SUPPORTOPS_APPROVAL_TTL_SECONDS=3600
SUPPORTOPS_ACTION_POLL_SECONDS=2
SUPPORTOPS_ACTION_LEASE_SECONDS=60
SUPPORTOPS_ACTION_TARGET_TIMEOUT_SECONDS=5
SUPPORTOPS_ACTION_MAX_EXECUTIONS=2
SUPPORTOPS_ACTION_MAX_RECONCILIATIONS=6
SUPPORTOPS_ACTION_MAX_MANUAL_RECONCILIATIONS=10

# 完整输入采用保守估算，当前问题和本轮工具轨迹始终保留。
SUPPORTOPS_AGENT_DEFAULT_MAX_INPUT_TOKENS=32768
SUPPORTOPS_AGENT_CONTEXT_HISTORY_TURNS=30
SUPPORTOPS_TENANT_RUN_LIMIT_PER_DAY=1000
SUPPORTOPS_TENANT_TOOL_LIMIT_PER_DAY=10000
SUPPORTOPS_TENANT_MODEL_CALL_LIMIT_PER_DAY=10000
# 按需设置 USD 硬预算；缺可信定价/usage 不当作零消费。
# SUPPORTOPS_TENANT_MODEL_COST_USD_PER_DAY=10

# 本地 envelope encryption 主密钥，用于加密模型 API Key；生产必须由密钥管理服务注入并更换。
SUPPORTOPS_SECRET_ENCRYPTION_KEY=replace-with-a-dedicated-secret-encryption-key
SUPPORTOPS_SECRET_PROVIDER=local_envelope_v1

# 模型端点域名 JSON 允许列表；本地空列表表示不额外限制，生产环境必须显式配置。
SUPPORTOPS_MODEL_ENDPOINT_ALLOWED_HOSTS=[]

# 是否允许模型端点解析到私网或回环地址；仅限受控本地开发，生产环境强制禁止。
SUPPORTOPS_MODEL_ENDPOINT_ALLOW_PRIVATE_NETWORKS=false

# 模型端点连接测试的请求超时，单位为秒。
SUPPORTOPS_MODEL_TEST_TIMEOUT_SECONDS=15

# 模型端点连接测试允许读取的最大响应体大小，单位为字节。
SUPPORTOPS_MODEL_TEST_MAX_RESPONSE_BYTES=1000000

# Agent 配置允许的模型调用次数硬上限。
SUPPORTOPS_AGENT_MODEL_CALL_LIMIT_MAX=12

# Agent 配置允许的工具调用次数硬上限。
SUPPORTOPS_AGENT_TOOL_CALL_LIMIT_MAX=20

# 单次 Agent Run 允许的总超时硬上限，单位为秒。
SUPPORTOPS_AGENT_RUN_TIMEOUT_SECONDS_MAX=600

# 单次 Agent Run 允许的最大并行工具数硬上限。
SUPPORTOPS_AGENT_MAX_PARALLEL_TOOLS_MAX=8

# LangGraph PostgreSQL checkpoint 使用的独立 Schema 名称。
SUPPORTOPS_LANGGRAPH_CHECKPOINT_SCHEMA=supportops_checkpoints

# 仅独立维护命令使用，默认关闭；启动 API/Worker 不会自动发送遥测。
SUPPORTOPS_TELEMETRY_EXPORT_ENABLED=false
SUPPORTOPS_TELEMETRY_CONVENTION_VERSION=supportops_otel_v1
SUPPORTOPS_TELEMETRY_ALLOWED_TENANTS=[]
SUPPORTOPS_TELEMETRY_ALLOWED_IPS=[]
SUPPORTOPS_TELEMETRY_BATCH_SIZE=100
SUPPORTOPS_TELEMETRY_MAX_PAYLOAD_BYTES=1000000
SUPPORTOPS_TELEMETRY_TIMEOUT_SECONDS=10
# 获得租户及目标批准后注入 HTTPS /v1/traces 端点、确切 IP 和独立的至少32字节HMAC密钥。
# SUPPORTOPS_TELEMETRY_OTLP_ENDPOINT=https://<approved-collector>/v1/traces
# SUPPORTOPS_TELEMETRY_HMAC_KEY=<independently-injected-secret>
# SUPPORTOPS_TELEMETRY_BEARER_TOKEN=<optional-independently-injected-token>

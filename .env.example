# 当前运行环境；local 表示本地开发配置。
SUPPORTOPS_ENVIRONMENT=local

# PostgreSQL 数据库名称，仅用于本地开发实例。
SUPPORTOPS_POSTGRES_DB=supportops

# PostgreSQL 本地开发用户名。
SUPPORTOPS_POSTGRES_USER=agent

# PostgreSQL 本地开发密码；生产环境必须替换为独立强密码。
SUPPORTOPS_POSTGRES_PASSWORD=agent_dev

# PostgreSQL 映射到宿主机的端口。
SUPPORTOPS_POSTGRES_PORT=5432

# API 和 Worker 使用的异步 PostgreSQL 连接地址。
SUPPORTOPS_DATABASE_URL=postgresql+asyncpg://agent:agent_dev@localhost:5432/supportops

# Redis 映射到宿主机的端口。
SUPPORTOPS_REDIS_PORT=6379

# API 和 Worker 使用的 Redis 连接地址，数据库编号为 0。
SUPPORTOPS_REDIS_URL=redis://localhost:6379/0

# Redis 中用于投递 Agent 运行任务的队列名称。
SUPPORTOPS_REDIS_QUEUE_NAME=supportops:runs

# 本地 JWT 签名密钥；生产环境必须通过安全的密钥管理服务注入。
SUPPORTOPS_JWT_SECRET=replace-with-at-least-32-characters

# JWT 签发方标识。
SUPPORTOPS_JWT_ISSUER=supportops-local

# JWT 预期接收方标识。
SUPPORTOPS_JWT_AUDIENCE=supportops-api

# 是否在空数据库首次启动时创建默认公司、根组织和管理员。
SUPPORTOPS_BOOTSTRAP_ADMIN_ENABLED=true

# 首次启动创建的默认公司名称。
SUPPORTOPS_BOOTSTRAP_COMPANY_NAME=SupportOps

# 首次启动创建的默认公司唯一短名。
SUPPORTOPS_BOOTSTRAP_COMPANY_SLUG=supportops

# 首次启动创建的平台管理员登录邮箱。
SUPPORTOPS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# 首次启动平台管理员密码；生产环境必须注入独立强密码。
SUPPORTOPS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 首次启动平台管理员显示名称。
SUPPORTOPS_BOOTSTRAP_ADMIN_NAME=系统管理员

# 登录访问令牌有效时长，单位为分钟。
SUPPORTOPS_ACCESS_TOKEN_LIFETIME_MINUTES=480

# 允许访问 API 的浏览器来源列表，使用 JSON 数组格式。
SUPPORTOPS_CORS_ORIGINS=["http://localhost:5173"]

# SSE 查询数据库中新事件的时间间隔，单位为秒。
SUPPORTOPS_SSE_POLL_INTERVAL_SECONDS=0.25

# SSE 在无新事件时发送心跳的时间间隔，单位为秒。
SUPPORTOPS_SSE_HEARTBEAT_SECONDS=10

# Worker 扫描并恢复滞留队列任务的时间间隔，单位为秒。
SUPPORTOPS_WORKER_RECOVERY_INTERVAL_SECONDS=30

# 本地 envelope encryption 主密钥，用于加密模型 API Key；生产必须由密钥管理服务注入并更换。
SUPPORTOPS_SECRET_ENCRYPTION_KEY=replace-with-a-dedicated-secret-encryption-key

# 模型端点域名 JSON 允许列表；本地空列表表示不额外限制，生产环境必须显式配置。
SUPPORTOPS_MODEL_ENDPOINT_ALLOWED_HOSTS=[]

# 是否允许模型端点解析到私网或回环地址；仅限受控本地开发，生产环境强制禁止。
SUPPORTOPS_MODEL_ENDPOINT_ALLOW_PRIVATE_NETWORKS=false

# 模型端点连接测试的请求超时，单位为秒。
SUPPORTOPS_MODEL_TEST_TIMEOUT_SECONDS=15

# 模型端点连接测试允许读取的最大响应体大小，单位为字节。
SUPPORTOPS_MODEL_TEST_MAX_RESPONSE_BYTES=1000000

# Agent 配置允许的模型调用次数硬上限。
SUPPORTOPS_AGENT_MODEL_CALL_LIMIT_MAX=12

# Agent 配置允许的工具调用次数硬上限。
SUPPORTOPS_AGENT_TOOL_CALL_LIMIT_MAX=20

# 单次 Agent Run 允许的总超时硬上限，单位为秒。
SUPPORTOPS_AGENT_RUN_TIMEOUT_SECONDS_MAX=600

# 单次 Agent Run 允许的最大并行工具数硬上限。
SUPPORTOPS_AGENT_MAX_PARALLEL_TOOLS_MAX=8

# LangGraph PostgreSQL checkpoint 使用的独立 Schema 名称。
SUPPORTOPS_LANGGRAPH_CHECKPOINT_SCHEMA=supportops_checkpoints
